#!/usr/bin/env python3
"""ani-party: browser watch party for ani-cli, no accounts, no transcode.

Browsers cannot send a Referer, so the friend's browser cannot fetch the CDN.
This process runs on the host for the length of the party and:
  * proxies the HLS playlists/segments byte-for-byte with the right Referer/Origin
    (segments are fetched from the CDN once and shared by every viewer),
  * converts the subtitle file to clean WebVTT (ASS typesetting filtered),
  * keeps one shared play/pause/position state, chat and the episode queue,
  * exposes all of it through an account-less tunnel (cloudflared quick tunnel,
    or `ssh nokey@localhost.run` when cloudflared is missing).
Viewers only open a link. Host machine needs python3 (stdlib only).

Started by `ani-cli -w`; arguments are ani-cli's party_url (url#ap&i=..&e=..).
"""
import argparse
import collections
import hashlib
import hmac
import json
import os
import re
